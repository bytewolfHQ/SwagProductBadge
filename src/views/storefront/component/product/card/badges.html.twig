{% sw_extends '@Storefront/storefront/component/product/card/badges.html.twig' %}

{% block component_product_badges %}
    {% set badgeLabel = product.customFields.swag_badge_label ?? null %}
    {% set badgeColor = product.customFields.swag_badge_color ?? 'primary' %}

    {{ parent() }}

    {% if badgeLabel %}
        <span class="badge bg-{{ badgeColor }}">
            {{ badgeLabel }}
        </span>
    {% endif %}
{% endblock %}